# Dependencies
node_modules/
.pnp
.pnp.js

# Testing
coverage/
*.lcov

# Production
build/
dist/
out/

# Misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Environment variables — never commit real credentials
# Safe to commit: *.example files, server/.env.test (all-fake values)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Expo overrides / local backups that may hold real URLs / tokens
mobile/.env.override
mobile/.env.local.backup
mobile/.env.production
# Explicit catch-all for real .env files in any subdirectory
**/.env.production
**/.env.local
# 1Password runtime references and operator manifests. The tracked examples
# contain no credentials; local copies may contain vault/account metadata.
.env.op
**/.env.op
ops/secrets/*.json
!ops/secrets/*.example.json


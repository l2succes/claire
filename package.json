{
  "name": "claire",
  "version": "0.1.0-alpha.1",
  "private": true,
  "workspaces": [
    "mobile",
    "desktop/macos",
    "website",
    "server",
    "packages/*",
    "examples/plugins/*"
  ],
  "scripts": {
    "setup": "bun run scripts/setup.ts",
    "dev": "concurrently \"bun run dev:server\" \"bun run dev:mobile\"",
    "dev:server": "cd server && bun run dev",
    "dev:mobile": "cd mobile && bun run dev",
    "dev:desktop": "cd desktop/macos && bun run start",
    "dev:website": "cd website && bun run dev",
    "dev:plugin": "bun test --watch examples/plugins",
    "plugin:create": "bun run scripts/plugin-create.ts",
    "test:plugins": "bun test examples/plugins",
    "landing": "bunx serve landing",
    "catalog:generate": "bun run scripts/generate-platform-catalog.ts",
    "secrets:bootstrap": "bun run scripts/secrets/bootstrap.ts",
    "secrets:check": "bun run scripts/secrets/check.ts",
    "secrets:sync:railway": "bun run scripts/secrets/sync-railway.ts",
    "secrets:provision:supabase-staging": "bun run scripts/secrets/provision-supabase-staging.ts",
    "secrets:provision:api-staging": "bun run scripts/secrets/provision-api-staging.ts",
    "dev:prod": "concurrently \"bun run dev:server\" \"bun run mobile:prod\"",
    "mobile:prod": "cd mobile && bun run start:prod",
    "mobile:prod:local": "cd mobile && bun run start:prod:local",
    "mobile:ios:prod": "cd mobile && bun run ios:prod",
    "mobile:ios:prod:local": "cd mobile && bun run ios:prod:local",
    "mobile:ios:prod:device": "cd mobile && bun run ios:prod:device",
    "mobile:ios:prod:device:local": "cd mobile && bun run ios:prod:device:local",
    "test": "bun run test:server && bun run test:mobile && bun run test:plugins",
    "test:server": "cd server && bun test",
    "test:mobile": "cd mobile && bun test",
    "lint": "bun run lint:server && bun run lint:mobile && bun run lint:website",
    "lint:server": "cd server && bun run lint",
    "lint:mobile": "cd mobile && bun run lint",
    "lint:website": "cd website && bun run lint",
    "typecheck": "bun run typecheck:server && bun run typecheck:mobile && bun run typecheck:website",
    "typecheck:server": "cd server && bun run typecheck",
    "typecheck:mobile": "cd mobile && bun run typecheck",
    "typecheck:website": "cd website && bun run typecheck",
    "storybook": "cd website && bun run storybook",
    "check": "bun run scripts/validate-licenses.ts && bun run lint && bun run typecheck && bun run test",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "install:server": "cd server && bun install",
    "install:mobile": "cd mobile && bun install",
    "docker:up": "bun run docker:supabase && bun run docker:matrix",
    "docker:down": "bun run docker:supabase:down && bun run docker:matrix:down",
    "docker:supabase": "docker compose -f docker/supabase/docker-compose.supabase.yml up -d",
    "docker:supabase:down": "docker compose -f docker/supabase/docker-compose.supabase.yml down",
    "docker:supabase:logs": "docker compose -f docker/supabase/docker-compose.supabase.yml logs -f",
    "docker:matrix": "docker compose -f docker/matrix/docker-compose.matrix.yml up -d",
    "docker:matrix:down": "docker compose -f docker/matrix/docker-compose.matrix.yml down",
    "docker:matrix:logs": "docker compose -f docker/matrix/docker-compose.matrix.yml logs -f"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prettier": "^3.1.1"
  }
}

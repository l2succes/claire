{
  "name": "claire",
  "version": "0.1.0-alpha.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "desktop/macos",
    "packages/*",
    "examples/plugins/*"
  ],
  "scripts": {
    "setup": "bun run scripts/setup.ts",
    "dev": "concurrently \"bun run dev:server\" \"bun run dev:mobile\"",
    "dev:server": "cd apps/server && bun run dev",
    "dev:mobile": "cd apps/client && bun run dev",
    "dev:desktop": "cd apps/desktop && bun run dev",
    "dev:website": "cd apps/website && bun run dev",
    "dev:plugin": "bun test --watch examples/plugins",
    "plugin:create": "bun run scripts/plugin-create.ts",
    "test:plugins": "bun test examples/plugins",
    "landing": "bunx serve landing",
    "catalog:generate": "bun run scripts/generate-platform-catalog.ts",
    "emails:build": "cd packages/emails && bun run build",
    "emails:preview": "cd packages/emails && bun run dev",
    "dev:prod": "concurrently \"bun run dev:server\" \"bun run mobile:prod\"",
    "mobile:prod": "cd apps/client && bun run start:prod",
    "mobile:prod:local": "cd apps/client && bun run start:prod:local",
    "mobile:ios:prod": "cd apps/client && bun run ios:prod",
    "mobile:ios:prod:local": "cd apps/client && bun run ios:prod:local",
    "mobile:ios:prod:device": "cd apps/client && bun run ios:prod:device",
    "mobile:ios:prod:device:local": "cd apps/client && bun run ios:prod:device:local",
    "test": "bun run test:server && bun run test:mobile && bun run test:plugins",
    "test:server": "cd apps/server && bun test",
    "test:mobile": "cd apps/client && bun test",
    "lint": "bun run lint:server && bun run lint:mobile && bun run lint:website",
    "lint:server": "cd apps/server && bun run lint",
    "lint:mobile": "cd apps/client && bun run lint",
    "lint:website": "cd apps/website && bun run lint",
    "typecheck": "bun run typecheck:server && bun run typecheck:mobile && bun run typecheck:website",
    "typecheck:server": "cd apps/server && bun run typecheck",
    "typecheck:mobile": "cd apps/client && bun run typecheck",
    "typecheck:website": "cd apps/website && bun run typecheck",
    "storybook": "cd apps/website && bun run storybook",
    "check": "bun run scripts/validate-licenses.ts && bun run lint && bun run typecheck && bun run test",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "install:server": "cd apps/server && bun install",
    "install:mobile": "cd apps/client && bun install",
    "docker:up": "bun run docker:supabase && bun run docker:matrix",
    "docker:down": "bun run docker:supabase:down && bun run docker:matrix:down",
    "docker:supabase": "docker compose -f docker/supabase/docker-compose.supabase.yml up -d",
    "docker:supabase:down": "docker compose -f docker/supabase/docker-compose.supabase.yml down",
    "docker:supabase:logs": "docker compose -f docker/supabase/docker-compose.supabase.yml logs -f",
    "docker:matrix": "docker compose -f docker/matrix/docker-compose.matrix.yml up -d",
    "docker:matrix:down": "docker compose -f docker/matrix/docker-compose.matrix.yml down",
    "docker:matrix:logs": "docker compose -f docker/matrix/docker-compose.matrix.yml logs -f",
    "graph": "nx graph",
    "affected": "nx affected -t typecheck lint test build",
    "many": "nx run-many -t typecheck lint test build",
    "desktop:dev": "cd apps/desktop && bun run dev",
    "desktop:prod": "cd apps/desktop && bun run prod",
    "desktop:prod:fresh": "cd apps/desktop && bun run prod:fresh",
    "desktop:package": "cd apps/desktop && bun run package",
    "desktop:package:dev": "cd apps/desktop && bun run package:dev",
    "desktop:macos": "cd desktop/macos && bun run start"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nx": "23.1.1",
    "prettier": "^3.1.1"
  }
}

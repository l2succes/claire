diff --git a/android/build.gradle b/android/build.gradle
index 428242d..a24d266 100644
--- a/android/build.gradle
+++ b/android/build.gradle
@@ -320,3 +320,35 @@ task prepareWorkletsHeadersForPrefabs(type: Copy) {
     include("worklets/**/*.h")
     into(workletsPrefabHeadersDir)
 }
+
+// Expo SDK 55 and Reanimated 4.2 still link Worklets from the legacy
+// intermediates/cmake path. AGP 9 writes CMake outputs under intermediates/cxx,
+// so publish a stable compatibility copy after each native build completes.
+afterEvaluate {
+    [
+        [variant: "Debug", cmakeBuildType: "Debug", legacyBuildType: "debug"],
+        [variant: "Release", cmakeBuildType: "RelWithDebInfo", legacyBuildType: "release"],
+    ].each { config ->
+        tasks.named("externalNativeBuild${config.variant}").configure {
+            doLast {
+                fileTree("$buildDir/intermediates/cxx/${config.cmakeBuildType}") {
+                    include "**/obj/*/libworklets.so"
+                }.files.each { library ->
+                    def destination = file("$buildDir/intermediates/cmake/${config.legacyBuildType}/obj/${library.parentFile.name}/libworklets.so")
+                    destination.parentFile.mkdirs()
+                    // Copy through a new inode: Gradle can hard-link source and destination.
+                    def staged = file("${destination.path}.staged")
+                    java.nio.file.Files.copy(library.toPath(), staged.toPath(), java.nio.file.StandardCopyOption.REPLACE_EXISTING)
+                    try {
+                        java.nio.file.Files.move(staged.toPath(), destination.toPath(),
+                            java.nio.file.StandardCopyOption.REPLACE_EXISTING,
+                            java.nio.file.StandardCopyOption.ATOMIC_MOVE)
+                    } catch (java.nio.file.AtomicMoveNotSupportedException ignored) {
+                        java.nio.file.Files.move(staged.toPath(), destination.toPath(),
+                            java.nio.file.StandardCopyOption.REPLACE_EXISTING)
+                    }
+                }
+            }
+        }
+    }
+}

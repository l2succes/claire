# Supabase Configuration (Public keys for client)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend Server URL
EXPO_PUBLIC_API_URL=http://localhost:3001

# Environment
EXPO_PUBLIC_ENV=development

# RevenueCat public SDK keys (safe to ship in the native binary).
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
# Use a RevenueCat Test Store key for simulator/local purchase testing.
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=
# `test` is appropriate for development/preview; production is always forced
# to the platform store even if this variable is misconfigured.
EXPO_PUBLIC_REVENUECAT_STORE=test
# Keep off until the store catalog and current offering are verified.
EXPO_PUBLIC_BILLING_ENFORCED=0

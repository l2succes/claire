{
  "name": "@claire/server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist",
    "start": "bun run dist/index.js",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "verify:schema": "bun run src/scripts/verify-schema.ts",
    "eval:loops": "bun run scripts/eval-loops.ts",
    "eval:loops:gates": "bun run scripts/eval-loops.ts --gates --seed 42 --per 6"
  },
  "dependencies": {
    "@ai-sdk/azure": "^4.0.43",
    "@ai-sdk/openai": "^4.0.42",
    "@ai-sdk/openai-compatible": "^3.0.31",
    "@anthropic-ai/bedrock-sdk": "^0.27.0",
    "@aws-sdk/client-s3": "^3.922.0",
    "@claire/platform-catalog": "workspace:*",
    "@sentry/node": "^10.62.0",
    "@supabase/supabase-js": "^2.39.1",
    "ai": "^7.0.66",
    "bull": "^4.11.5",
    "chokidar": "^5.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "instagram-private-api": "^1.46.1",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "matrix-js-sdk": "^40.2.0-rc.0",
    "morgan": "^1.10.0",
    "openai": "^4.24.1",
    "postgres": "^3.4.7",
    "puppeteer": "^21.6.1",
    "qrcode": "^1.5.3",
    "qrcode-terminal": "^0.12.0",
    "telegraf": "^4.16.3",
    "whatsapp-web.js": "^1.34.6",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.6.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.5",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.1",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3"
  },
  "nx": {
    "tags": [
      "scope:server",
      "type:app"
    ]
  }
}
